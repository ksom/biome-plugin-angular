// Port of @angular-eslint/directive-selector with the Angular CLI defaults:
// attribute selectors, camelCase, `app` prefix (`[appHighlight]`).
// Comma-separated selector lists are accepted when every entry is valid.
// Biome plugins take no options, so a project using another prefix must copy
// this file and edit the regex.
language js

`@Directive({ $args })` where {
  $args <: contains `selector: $selector`,
  $selector <: not r"^['\"]\[app[A-Z][A-Za-z0-9]*\](?:\s*,\s*\[app[A-Z][A-Za-z0-9]*\])*['\"]$",
  register_diagnostic(span = $selector, message = "[directive-selector] Angular directive selector must be a camelCase attribute with the 'app' prefix, e.g. '[appHighlight]'.", severity = "warn")
}
