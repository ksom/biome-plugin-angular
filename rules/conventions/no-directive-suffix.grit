// Port of the Angular v20+ style-guide guidance: drop the "Directive" suffix.
// Only classes decorated with @Directive are flagged (plain TS classes are not).
//
// Classes are matched through Biome's native AST nodes instead of code
// snippets so that every class shape is covered: `export`, `export default`,
// `extends`, generics and `implements` clauses. Decorators written before
// `export` are attached to the JsExport node, hence the three branches.
language js

or {
  JsClassDeclaration(decorators = $decorators, id = $name),
  JsExport(decorators = $decorators, export_clause = JsClassDeclaration(id = $name)),
  JsExport(decorators = $decorators, export_clause = JsExportDefaultDeclarationClause(declaration = JsClassExportDefaultDeclaration(id = $name)))
} where {
  $decorators <: contains `@Directive($args)`,
  $name <: r".*Directive$",
  register_diagnostic(span = $name, message = "[no-directive-suffix] Angular v20+: remove the 'Directive' suffix from class names. Name classes after what they represent.", severity = "warn")
}
