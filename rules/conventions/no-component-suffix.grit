// Port of the Angular v20+ style-guide guidance: drop the "Component" suffix.
// Only classes decorated with @Component are flagged (plain TS classes are not).
// Patterns include explicit `export class` variants — GritQL treats the export
// modifier as part of the matched statement. Known false negative: decorated
// classes with an `implements` clause cannot be matched by GritQL.
language js

or {
  `@Component($a)
class $name { $_ }`,
  `@Component($a)
export class $name { $_ }`,
  `@Component($a)
class $name extends $ext { $_ }`,
  `@Component($a)
export class $name extends $ext { $_ }`
} where {
  $name <: r".*Component$",
  register_diagnostic(span = $name, message = "Angular v20+: remove the 'Component' suffix from class names. Name classes after what they represent.", severity = "warn")
}
