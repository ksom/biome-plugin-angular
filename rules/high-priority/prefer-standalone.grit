// Port of @angular-eslint/prefer-standalone, aligned with Angular 19+ where
// standalone: true is the default and the v20 style guide recommends omitting
// the property entirely. Only an explicit standalone: false is flagged.
language js

or {
  `@Component({ $args })`,
  `@Directive({ $args })`,
  `@Pipe({ $args })`
} where {
  $args <: contains `standalone: false`,
  register_diagnostic(span = $args, message = "Avoid standalone: false. Standalone is the default since Angular 19 — migrate this declarable off NgModules and remove the property.")
}
