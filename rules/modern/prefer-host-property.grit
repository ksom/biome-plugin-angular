// Angular v20+ style guide: declare host bindings and listeners in the
// `host` property of @Component/@Directive instead of the @HostBinding and
// @HostListener decorators.
language js

or { `@HostBinding($args)`, `@HostListener($args)` } as $decorator where {
  register_diagnostic(span = $decorator, message = "[prefer-host-property] Prefer host: {} in @Component/@Directive over @HostBinding/@HostListener decorators.", severity = "warn")
}
