// Port of @angular-eslint/use-lifecycle-interface.
// Every lifecycle method must have its interface (OnInit for ngOnInit, …) in
// the implements clause of ITS class. The method is matched first, then the
// enclosing class node is read through `within`, so the check is per class
// (not per file) and any method signature is covered (`: void`, `async`,
// parameters, modifiers). One branch per hook: diagnostic messages are
// static strings, and each one names the missing interface.
language js

or {
  JsMethodClassMember(name = `ngOnChanges`) as $method where {
    $method <: within or { JsClassDeclaration(implements_clause = $impl), JsClassExportDefaultDeclaration(implements_clause = $impl) },
    $impl <: not contains `OnChanges`,
    register_diagnostic(span = $method, message = "[use-lifecycle-interface] Lifecycle method ngOnChanges: implement the OnChanges interface.", severity = "warn")
  },
  JsMethodClassMember(name = `ngOnInit`) as $method where {
    $method <: within or { JsClassDeclaration(implements_clause = $impl), JsClassExportDefaultDeclaration(implements_clause = $impl) },
    $impl <: not contains `OnInit`,
    register_diagnostic(span = $method, message = "[use-lifecycle-interface] Lifecycle method ngOnInit: implement the OnInit interface.", severity = "warn")
  },
  JsMethodClassMember(name = `ngDoCheck`) as $method where {
    $method <: within or { JsClassDeclaration(implements_clause = $impl), JsClassExportDefaultDeclaration(implements_clause = $impl) },
    $impl <: not contains `DoCheck`,
    register_diagnostic(span = $method, message = "[use-lifecycle-interface] Lifecycle method ngDoCheck: implement the DoCheck interface.", severity = "warn")
  },
  JsMethodClassMember(name = `ngAfterContentInit`) as $method where {
    $method <: within or { JsClassDeclaration(implements_clause = $impl), JsClassExportDefaultDeclaration(implements_clause = $impl) },
    $impl <: not contains `AfterContentInit`,
    register_diagnostic(span = $method, message = "[use-lifecycle-interface] Lifecycle method ngAfterContentInit: implement the AfterContentInit interface.", severity = "warn")
  },
  JsMethodClassMember(name = `ngAfterContentChecked`) as $method where {
    $method <: within or { JsClassDeclaration(implements_clause = $impl), JsClassExportDefaultDeclaration(implements_clause = $impl) },
    $impl <: not contains `AfterContentChecked`,
    register_diagnostic(span = $method, message = "[use-lifecycle-interface] Lifecycle method ngAfterContentChecked: implement the AfterContentChecked interface.", severity = "warn")
  },
  JsMethodClassMember(name = `ngAfterViewInit`) as $method where {
    $method <: within or { JsClassDeclaration(implements_clause = $impl), JsClassExportDefaultDeclaration(implements_clause = $impl) },
    $impl <: not contains `AfterViewInit`,
    register_diagnostic(span = $method, message = "[use-lifecycle-interface] Lifecycle method ngAfterViewInit: implement the AfterViewInit interface.", severity = "warn")
  },
  JsMethodClassMember(name = `ngAfterViewChecked`) as $method where {
    $method <: within or { JsClassDeclaration(implements_clause = $impl), JsClassExportDefaultDeclaration(implements_clause = $impl) },
    $impl <: not contains `AfterViewChecked`,
    register_diagnostic(span = $method, message = "[use-lifecycle-interface] Lifecycle method ngAfterViewChecked: implement the AfterViewChecked interface.", severity = "warn")
  },
  JsMethodClassMember(name = `ngOnDestroy`) as $method where {
    $method <: within or { JsClassDeclaration(implements_clause = $impl), JsClassExportDefaultDeclaration(implements_clause = $impl) },
    $impl <: not contains `OnDestroy`,
    register_diagnostic(span = $method, message = "[use-lifecycle-interface] Lifecycle method ngOnDestroy: implement the OnDestroy interface.", severity = "warn")
  }
}
