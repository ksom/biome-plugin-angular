{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "plugins": [
    {
      "path": "./node_modules/biome-plugin-angular",
      "includes": ["**/*.ts", "!**/*.spec.ts"]
    }
  ],
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "rules": {
      "style": {
        "useImportType": "off"
      }
    }
  }
}
